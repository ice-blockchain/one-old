{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Detecting project mode...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.cjs\" session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Applying traffic-one rules...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.cjs\" user-prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Validating architecture...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.cjs\" check-architecture-write"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking library allowlist...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.cjs\" check-library-allowlist"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading stack rules...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.cjs\" post-stack-setup"
          }
        ]
      }
    ]
  }
}
