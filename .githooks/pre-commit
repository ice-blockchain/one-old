#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ ! -x node_modules/.bin/tsx ]; then
  echo "pre-commit: missing node_modules/.bin/tsx; run npm install before committing." >&2
  exit 1
fi

# Do not run gen first: plugin:check is fallbacks:check + gen:check +
# build:verify against the tree as committed. Generating immediately before
# gen:check made the check tautological.
npm run plugin:check
node --import ./src/build/test-preload.mjs --import tsx --test tests/golden/golden-snapshot.test.ts
