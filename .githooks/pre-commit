#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ ! -x node_modules/.bin/tsx ]; then
  echo "pre-commit: missing node_modules/.bin/tsx; run npm install before committing." >&2
  exit 1
fi

node_modules/.bin/tsx src/gen/index.ts
npm run build
npm run gen:check
npm run build:verify
