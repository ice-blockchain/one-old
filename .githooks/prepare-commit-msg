#!/bin/sh
set -eu

message_file="${1:-}"

if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  exit 0
fi

if [ "${TRAFFIC_ONE_COMMIT_TRAILER:-1}" = "0" ]; then
  exit 0
fi

git interpret-trailers \
  --in-place \
  --if-exists addIfDifferent \
  --trailer "Integrated-With: Traffic One plugin <noreply@traffic.io>" \
  "$message_file"
