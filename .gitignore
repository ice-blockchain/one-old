# IDE
.idea/
.vscode/
*.iml

# Claude Code local session settings — never commit these
.claude/settings.local.json
.claude/

# traffic-one per-project state — written at session start, not committed
.traffic-one/
.claude-plugin-mode
.orphaned_at

# codebase-graph artefacts (generated; consumed but never committed)
graphify-out/
.gitnexus/

# OS
.DS_Store
Thumbs.db

# Python tooling
__pycache__/
*.pyc

# Node build tooling and generated plugin output
node_modules/
dist/
*.tsbuildinfo

# Scratch space for tooling that must not write outside the workspace:
# probe scripts, mutation-test copies, measurement drivers, progress logs.
#
# Anchored with a leading slash ON PURPOSE. Unanchored, `.tmp/` matches at every
# depth, so a scratch tree at src/.tmp would be invisible to `git status` while
# still being swept into the test glob and tsconfig's include — the lane would
# debug its own fixtures with nothing pointing at them. Anchoring keeps a
# misplaced scratch dir untracked-but-visible, which is the same principle the
# rest of this file follows: never hide something the reader needs to see.
/.tmp/
