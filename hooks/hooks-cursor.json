{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./scripts/cursor-hook-runtime.cjs session-start"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./scripts/cursor-hook-runtime.cjs user-prompt-submit"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./scripts/cursor-hook-runtime.cjs before-shell-execution"
      }
    ],
    "afterShellExecution": [
      {
        "command": "node ./scripts/cursor-hook-runtime.cjs after-shell-execution"
      }
    ],
    "beforeReadFile": [
      {
        "command": "node ./scripts/cursor-hook-runtime.cjs before-read-file"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node ./scripts/cursor-hook-runtime.cjs after-file-edit"
      }
    ]
  }
}
