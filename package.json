{
  "name": "traffic-one",
  "version": "2.9.228",
  "private": true,
  "type": "commonjs",
  "description": "Build + codegen tooling for the Traffic One plugin. Readable source lives in src/; generated plugin output lives in ignored dist/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lighthouse.json",
    "build": "tsx src/build/build-runtime.ts dist/scripts",
    "build:verify": "tsx src/build/verify-build.ts",
    "gen": "tsx src/gen/index.ts",
    "gen:check": "tsx src/gen/index.ts --check",
    "golden:update": "tsx src/build/golden-update.ts",
    "plugin:build": "npm run gen && npm run build",
    "plugin:check": "npm run gen:check && npm run build:verify",
    "smoke": "tsx src/build/compiled-smoke.ts",
    "test": "node --import ./src/build/test-preload.mjs --import tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:env": "tsx src/test-environment/run.ts",
    "test:env:dry": "tsx src/test-environment/run.ts --dry-run",
    "test:env:e2e": "tsx src/test-environment/run.ts --e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
